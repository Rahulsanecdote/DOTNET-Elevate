rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to read and write only their own files in their designated folder.
    // The path is structured as /users/{uid}/uploads/{kitId}/{fileName}
    match /users/{uid}/uploads/{kitId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
